# Copy this file to .env for local development.
# Never commit your real .env file.

SPOONACULAR_KEY=your_spoonacular_api_key_here

# Optional: restrict browser origins when your Flask API is hosted separately.
# Example: CORS_ORIGINS=https://your-netlify-site.netlify.app,http://localhost:8888
CORS_ORIGINS=

# Local Flask settings
PORT=5000
FLASK_DEBUG=false
